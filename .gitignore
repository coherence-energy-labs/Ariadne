data/kernels/*
!data/kernels/kernels.lock.json
*.bsp
*.bpc
*.tls
*.tpc
*.tf
*.ti

# Bundled GMAT install (~1 GB) and its run artifacts — never commit
tools/
*.report.txt

# Generated results / atlas
results/
*.h5
*.hdf5

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated tutorial outputs (regenerate via `python examples/*.py`)
# The 5 committed PNGs make the README render on GitHub without running the tutorials.
examples_out/*
!examples_out/0[1-7]_*.png

# Scratch benchmarks at repo root (not committed -- the committed ones live in benchmarks/)
/bench_*.py

# Sphinx build output
docs/sphinx/_build/

# Discovery-engine cached data
/signalbook-data/
